# Copy to .env and fill in. Never commit .env.

# Postgres in production (Neon, Supabase, Railway...). SQLite is fine for local testing.
DATABASE_URL=sqlite:///./speed_to_lead.db
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME

# The public HTTPS address of this app, exactly as entered in Twilio's webhook settings.
PUBLIC_BASE_URL=https://your-app.up.railway.app

# Long random string. Protects the staff inbox at /admin?token=...
ADMIN_TOKEN=

# Live demo at /demo. On a public server set DEMO_TOKEN (open /demo?token=...) or disable it.
ENABLE_DEMO=true
DEMO_TOKEN=

# Which LLM runs the conversations: gemini (free tier, for testing) or anthropic
LLM_PROVIDER=gemini

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# 0 = no thinking (fastest). Raise to e.g. 512 if tool use looks sloppy; adds latency.
GEMINI_THINKING_BUDGET=0

# Only needed when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
VALIDATE_TWILIO_SIGNATURE=true
TWILIO_HANDLES_OPT_OUT=true

# base64 of the Google service-account JSON key:  base64 -w0 key.json   (macOS: base64 -i key.json)
GOOGLE_SERVICE_ACCOUNT_JSON_B64=

# Optional email alerts (Slack webhooks are set per client in its JSON file)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM_EMAIL=
